# Accepted hits of scripts/scrub-check. One entry per line: <path glob>:<regex>
# The matching text is cut from lines of matching files before the check, so
# an entry allows exactly that text and nothing else on the line.
# Every entry has its reason above it. Keep the list short.

# Example hosts and users in docs, help text, the API schema and unit tests:
# 10.0.0.x test vectors, a made-up .lan host, and a stand-in home folder.
docs/*.md:\b10\.0\.0\.[0-9]{1,3}\b
schema/*.openrpc.json:\b10\.0\.0\.[0-9]{1,3}\b
crates/lumbridge-core/src/api/types.rs:\b10\.0\.0\.[0-9]{1,3}\b
crates/lumbridge-core/src/machines.rs:\b10\.0\.0\.[0-9]{1,3}\b|\bcan@[Rr]ohan\.lan\b
crates/lumbridge-core/tests/windows.rs:\b10\.0\.0\.[0-9]{1,3}\b
crates/lumbridge-core/src/platform/systemd.rs:/home/u\b

# Third-party licence texts carry their authors' addresses. They must stay as they are.
crates/lumbridge-core/THIRD-PARTY-NOTICES:[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[a-z]{2,}\b
distribution/notices/*.txt:[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[a-z]{2,}\b

# README credits the project Lumbridge started from.
README.md:\[Herdr\]\(https://github\.com/herdrdev/herdr[a-z-]*\)
